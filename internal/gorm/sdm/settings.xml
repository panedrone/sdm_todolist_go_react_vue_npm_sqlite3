          xsi:noNamespaceSchemaLocation="settings.xsd">

    <folders target="sdm_demo_todolist" sql="internal/gorm/sdm/sql"/>

    <dto scope="internal/gorm/dbal/models" inheritance="" field-names-mode="0" macro=""/>

    <dao scope="internal/gorm/dbal" field-assign-mode="3" macro=""/>

    <ide event-log="true"/>

