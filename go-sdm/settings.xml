<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="settings.xsd">

    <!-- Paths are relative to the project root (the folder of go.mod).
         The generated code is the data layer of the application: keep it under internal/. -->

    <!-- target: "module" from go.mod; sql: base folder of SQL files -->

    <folders target="sdm_demo_todolist" sql="go-sdm/sql"/>

    <!-- scope: folder of generated models; field-names-mode: 0 - TitleCase -->

    <dto scope="internal/dbal/models" inheritance="" field-names-mode="0" macro=""/>

    <!-- scope: folder of generated DAO files

         field-assign-mode:
            0 - by column name (database/sql, gorm)
            1 - by field position (unsafe)
            2 - ptr to DTO or ptr to slice of DTO-s (gorm, sqlx)
            3 - ptr to resulting slice of DTO-s (gorm, sqlx) -->

    <dao scope="internal/dbal" field-assign-mode="0" macro=""/>

    <ide event-log="true"/>

    <!-- One settings.xml for the IDE plug-in and for go-sdm:
            jdbc  - the IDE plug-in (jar, class and url of JDBC); go-sdm does not read it.
            go-db - go-sdm (url: postgres://host:port/db, mysql://host:port/db or sqlite:<file>);
                    the IDE plug-in ignores it. SDM_PWD, if set, overrides "pwd" of go-db. -->


    <jdbc jar="lib/sqlite-jdbc-3.53.2.1.jar" class="org.sqlite.JDBC"
          url="jdbc:sqlite:$PROJECT_DIR$/db/todolist.sqlite" user="" pwd=""/>

    <go-db url="sqlite:db/todolist.sqlite" user="" pwd=""/>

    <!-- detected: the type of a column as the driver names it. The keys below are SQLite
         (sdm init -db pg, mysql or sqlite). PostgreSQL says int4, varchar, timestamptz, ...;
         MySQL says INT, VARCHAR, DATETIME, UNSIGNED BIGINT, ...;
         SQLite says what the column is declared with: INTEGER, VARCHAR, ...

         To see which names your database gives, empty the type-map: <type-map default=""/>
         and generate. The code then has the raw names of the driver instead of Go types.
         unknown - the driver said nothing about the type (MySQL parameters, SQLite expressions).

         A class is generated for database/sql, sqlx or gorm by its name in sdm.xml:
            <dto-class name="Task" ...>       - the keys without prefix
            <dto-class name="sqlx-Task" ...>  - the keys with "sqlx-"
            <dto-class name="gorm-Task" ...>  - the keys with "gorm-" ("+auto" - auto="..." column)
         The data store in the DAO folder has to match: sdm init -orm no_orm, sqlx or gorm.
         The sets you don't use can be removed or commented out. -->

    <type-map default="">

        <!-- sqlite3, for plugin -->

        <type detected="java.lang.Integer" target="int64${json} -> SetInt64"/>
        <type detected="java.lang.Double" target="float64${json} -> SetFloat64"/>
        <type detected="java.lang.String" target="string${json} -> SetString"/>
        <type detected="byte[]" target="[]byte${json} -> SetBytes"/>
        <type detected="java.lang.Object" target="any${json}"/>

        <!-- database/sql (no ORM) -->

        <type detected="INTEGER" target="int64${json} -> SetInt64"/>
        <type detected="INT" target="int64${json} -> SetInt64"/>
        <type detected="BIGINT" target="int64${json} -> SetInt64"/>
        <type detected="SMALLINT" target="int64${json} -> SetInt64"/>
        <type detected="TINYINT" target="int64${json} -> SetInt64"/>
        <type detected="MEDIUMINT" target="int64${json} -> SetInt64"/>
        <type detected="UNSIGNED BIG INT" target="int64${json} -> SetInt64"/>
        <type detected="INT2" target="int64${json} -> SetInt64"/>
        <type detected="INT8" target="int64${json} -> SetInt64"/>
        <type detected="STRING" target="string${json} -> SetString"/>
        <type detected="VARYING CHARACTER" target="string${json} -> SetString"/>
        <type detected="NATIVE CHARACTER" target="string${json} -> SetString"/>
        <type detected="REAL" target="float64${json} -> SetFloat64"/>
        <type detected="DOUBLE" target="float64${json} -> SetFloat64"/>
        <type detected="FLOAT" target="float64${json} -> SetFloat64"/>
        <type detected="NUMERIC" target="float64${json} -> SetFloat64"/>
        <type detected="DECIMAL" target="float64${json} -> SetFloat64"/>
        <type detected="TEXT" target="string${json} -> SetString"/>
        <type detected="VARCHAR" target="string${json} -> SetString"/>
        <type detected="CHAR" target="string${json} -> SetString"/>
        <type detected="CHARACTER" target="string${json} -> SetString"/>
        <type detected="NVARCHAR" target="string${json} -> SetString"/>
        <type detected="NCHAR" target="string${json} -> SetString"/>
        <type detected="CLOB" target="string${json} -> SetString"/>
        <type detected="BLOB" target="[]byte${json} -> SetBytes"/>
        <type detected="DOUBLE PRECISION" target="float64${json} -> SetFloat64"/>
        <type detected="MONEY" target="float64${json} -> SetFloat64"/>
        <type detected="NTEXT" target="string${json} -> SetString"/>
        <type detected="BINARY" target="[]byte${json} -> SetBytes"/>
        <type detected="VARBINARY" target="[]byte${json} -> SetBytes"/>
        <type detected="IMAGE" target="[]byte${json} -> SetBytes"/>
        <type detected="BIT" target="int64${json} -> SetInt64"/>

        <type detected="BOOLEAN" target="bool${json} -> SetBool"/>
        <type detected="DATE" target="time:time.Time${json} -> SetTime"/>
        <type detected="DATETIME" target="time:time.Time${json} -> SetTime"/>
        <type detected="TIMESTAMP" target="time:time.Time${json} -> SetTime"/>
        <type detected="unknown" target="any${json}"/>

        <!-- sqlx -->

        <type detected="sqlx-INTEGER" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-INT" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-BIGINT" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-SMALLINT" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-TINYINT" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-MEDIUMINT" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-UNSIGNED BIG INT" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-INT2" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-INT8" target="int64${json-sqlx} -> SetInt64"/>
        <type detected="sqlx-STRING" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-VARYING CHARACTER" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-NATIVE CHARACTER" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-REAL" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-DOUBLE" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-FLOAT" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-NUMERIC" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-DECIMAL" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-TEXT" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-VARCHAR" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-CHAR" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-CHARACTER" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-NVARCHAR" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-NCHAR" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-CLOB" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-BLOB" target="[]byte${json-sqlx} -> SetBytes"/>
        <type detected="sqlx-DOUBLE PRECISION" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-MONEY" target="float64${json-sqlx} -> SetFloat64"/>
        <type detected="sqlx-NTEXT" target="string${json-sqlx} -> SetString"/>
        <type detected="sqlx-BINARY" target="[]byte${json-sqlx} -> SetBytes"/>
        <type detected="sqlx-VARBINARY" target="[]byte${json-sqlx} -> SetBytes"/>
        <type detected="sqlx-IMAGE" target="[]byte${json-sqlx} -> SetBytes"/>
        <type detected="sqlx-BIT" target="int64${json-sqlx} -> SetInt64"/>

        <type detected="sqlx-BOOLEAN" target="bool${json-sqlx} -> SetBool"/>
        <type detected="sqlx-DATE" target="time:time.Time${json-sqlx} -> SetTime"/>
        <type detected="sqlx-DATETIME" target="time:time.Time${json-sqlx} -> SetTime"/>
        <type detected="sqlx-TIMESTAMP" target="time:time.Time${json-sqlx} -> SetTime"/>
        <type detected="sqlx-unknown" target="any${json-sqlx}"/>

        <!-- gorm -->

        <type detected="gorm-INTEGER" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-INT" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-BIGINT" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-SMALLINT" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-TINYINT" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-MEDIUMINT" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-UNSIGNED BIG INT" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-INT2" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-INT8" target="int64${json-gorm} -> SetInt64"/>
        <type detected="gorm-STRING" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-VARYING CHARACTER" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-NATIVE CHARACTER" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-REAL" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-DOUBLE" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-FLOAT" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-NUMERIC" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-DECIMAL" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-TEXT" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-VARCHAR" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-CHAR" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-CHARACTER" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-NVARCHAR" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-NCHAR" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-CLOB" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-BLOB" target="[]byte${json-gorm} -> SetBytes"/>
        <type detected="gorm-DOUBLE PRECISION" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-MONEY" target="float64${json-gorm} -> SetFloat64"/>
        <type detected="gorm-NTEXT" target="string${json-gorm} -> SetString"/>
        <type detected="gorm-BINARY" target="[]byte${json-gorm} -> SetBytes"/>
        <type detected="gorm-VARBINARY" target="[]byte${json-gorm} -> SetBytes"/>
        <type detected="gorm-IMAGE" target="[]byte${json-gorm} -> SetBytes"/>
        <type detected="gorm-BIT" target="int64${json-gorm} -> SetInt64"/>

        <type detected="gorm-BOOLEAN" target="bool${json-gorm} -> SetBool"/>
        <type detected="gorm-DATE" target="${json-gorm-time}"/>
        <type detected="gorm-DATETIME" target="${json-gorm-time}"/>
        <type detected="gorm-TIMESTAMP" target="${json-gorm-time}"/>
        <type detected="gorm-unknown" target="any${json-gorm}"/>

    </type-map>

    <macros>

        <macro value="=built-in=" name="${column}"/>
        <macro value="=built-in=" name="${lower_snake_case(column)}"/>
        <macro value="=built-in=" name="${camelCase(column)}"/>
        <macro value="=built-in=" name="${TitleCase(column)}"/>
        <macro value="=built-in=" name="${kebab-case(column)}"/>

        <macro name="${json-col}" value="${lower_snake_case(column)}"/>

        <macro name="${json}" value=" `json:&quot;${json-col}${0}&quot;`"/>

        <macro name="${json-sqlx}" value=" `json:&quot;${json-col}${0}&quot; db:&quot;${column}&quot;`"/>

        <macro name="${json-gorm}"
               value=" `json:&quot;${json-col}${0}&quot; gorm:&quot;column:${column}${gorm-params}${1}&quot;`"/>

        <macro name="${json-gorm-time}" value="time:time.Time${json-gorm} -> SetTime"/>

        <!-- gorm tag parameters from the metadata of the column -->
        <macro name="${gorm-params}">
            <vm-xml>
                <if var="$fi.ColumnSize > 0">
                    <print var=";size:$fi.ColumnSize"/>
                </if>
                <if var="$fi.PK">
                    <print var=";primaryKey"/>
                    <if var="$fi.AI">
                        <print var=";autoIncrement"/>
                    </if>
                    <else>
                        <if var="$fi.Unique &amp;&amp; $fi.Indexed">
                            <print var=";uniqueIndex"/>
                            <else>
                                <if var="$fi.Unique">
                                    <print var=";unique"/>
                                </if>
                                <if var="$fi.Indexed">
                                    <print var=";index"/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <if var="!$fi.Nullable">
                    <print var=";not null"/>
                </if>
            </vm-xml>
        </macro>

    </macros>

</settings>
